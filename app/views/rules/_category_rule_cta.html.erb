<%# locals: (cta:) %>

<% message = t(".message", category: cta[:category_name]) %>
<% description = t(".description") %>

<%= render "shared/notifications/cta", message: message, description: description do %>
  <%= form_with url: rule_prompt_settings_user_path(Current.user), method: :patch do %>
    <div class="flex gap-2 items-center mb-3 -mt-1">
      <%= check_box_tag "user[rule_prompts_enabled]", "0", false, id: "rule_prompts_off", class: "checkbox checkbox--light" %>
      <%= label_tag "rule_prompts_off", t(".disable_all"), class: "text-xs text-secondary" %>
    </div>

    <%= hidden_field_tag "user[dismissed_rule_prompt_category_id]", cta[:category_id], id: nil %>

    <%= tag.div class:"flex gap-2 justify-end" do %>
      <%= render DS::Button.new(text: t(".skip_category"), variant: "secondary", type: :submit) %>
      <% rule_href = new_rule_path(resource_type: "transaction", action_type: "set_transaction_category", action_value: cta[:category_id], name: cta[:merchant_name]) %>
      <%= render DS::Link.new(text: t(".create_rule"), variant: "primary", href: rule_href, frame: :modal) %>
    <% end %>
  <% end %>
<% end %>
